{
  "name": "pi-speak-pk",
  "version": "0.2.1",
  "description": "Voice, wake-word, Telegram, and mobile web remote extensions for Pi.",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "extension",
    "speech",
    "text-to-speech",
    "voice",
    "telegram",
    "remote-control",
    "pwa"
  ],
  "main": "dist/index.js",
  "bin": {
    "pi-speak-admin": "dist/ui/admin.js",
    "pi-speak-tray": "dist/persistent-tray.js",
    "pi-speak-gateway": "dist/headless-gateway.js"
  },
  "files": [
    "dist",
    "web",
    "listener",
    "unified-remote",
    "SKILL.md",
    "CHANGELOG.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:ui": "tsc -p tsconfig.ui.json && node scripts/sync-ui-package.mjs",
    "test": "npm run build && npm run build:ui && node --test tests/*.test.mjs",
    "prepublishOnly": "npm run build && npm run build:ui"
  },
  "dependencies": {
    "ink": "^7.0.0",
    "node-edge-tts": "^1.2.10",
    "qrcode": "^1.5.4",
    "react": "^19.2.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@mariozechner/pi-coding-agent": "^0.66.1",
    "@types/node": "^22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "typescript": "^5.8.3"
  }
}
