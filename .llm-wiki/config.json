  "stack": {
    "retrieval": {
      "primary": "pk-qmd",
      "memory": "byterover",
      "graph": "gitvizz"
    },
    "retrieval_planner": {
      "default_context_mode": "default",
      "default_evidence_plane": "all",
      "planes": [
