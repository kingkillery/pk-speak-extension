{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pk-skills1.local/schemas/g-kade/execution-contract.schema.json",
  "title": "g-kade Execution Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "definition_of_done": {"type": "string", "minLength": 1},
    "exclusive_scope": {"type": "string", "minLength": 1},
    "inputs": {"type": "array", "items": {"type": "string"}, "default": []},
    "constraints": {"type": "array", "items": {"type": "string"}, "default": []},
    "non_goals": {"type": "array", "items": {"type": "string"}, "default": []},
    "allowed_side_effects": {"type": "array", "items": {"type": "string"}, "default": []},
    "blocked_actions": {"type": "array", "items": {"type": "string"}, "default": []},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "string"}, "default": []},
    "return_format": {"type": "string", "minLength": 1},
    "review_gate": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "minLength": 1}
  },
  "required": [
    "id",
    "objective",
    "definition_of_done",
    "exclusive_scope",
    "inputs",
    "constraints",
    "non_goals",
    "allowed_side_effects",
    "blocked_actions",
    "required_evidence",
    "validation",
    "return_format",
    "created_at",
    "created_by"
  ]
}
