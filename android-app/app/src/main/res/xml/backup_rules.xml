<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules (pre-API-31 path).
   pi_speak_prefs holds the gateway auth token and the optional ElevenLabs API key,
   so it must never leave the device via cloud backup.
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="sharedpref" path="pi_speak_prefs.xml"/>
</full-backup-content>
