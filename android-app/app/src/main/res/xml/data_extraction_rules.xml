<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules (API 31+ path).
   pi_speak_prefs holds the gateway auth token and the optional ElevenLabs API key,
   so it is excluded from both cloud backup and device-to-device transfer.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="pi_speak_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="pi_speak_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
