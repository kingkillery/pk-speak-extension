<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Pure white window for the e-ink build. White status/nav bars with dark icons
         so the system chrome blends into the paper-white UI and never flashes a tinted
         surface that would ghost on the e-ink panel. -->
    <style name="Theme.PiSpeakEink" parent="android:Theme.DeviceDefault.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
