<?xml version="1.0" encoding="utf-8"?>
<!--
  E-ink (Onyx Boox Palma) flavor manifest.
  Replaces the standard phone launcher (MainActivity) with BooxMainActivity so the
  e-ink build has a single launcher icon and is the sole owner of the pi-speak://setup
  onboarding deep link (no disambiguation chooser when scanning the /pk-remote QR).
  Merged on top of src/main/AndroidManifest.xml for the `boox` flavor only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- The standard phone UI is not shipped on the e-ink build. -->
        <activity android:name=".MainActivity" tools:node="remove" />

        <activity
            android:name=".BooxMainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:label="@string/app_name"
            android:theme="@style/Theme.PiSpeakEink">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Zero-touch onboarding deep link (same scheme as the standard build). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="pi-speak" android:host="setup" />
            </intent-filter>
        </activity>

        <!-- Smoke activity retained for diagnostics; NOT the launcher. -->
        <activity
            android:name=".BooxSmokeActivity"
            android:exported="false" />
    </application>

</manifest>
