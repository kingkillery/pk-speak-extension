{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pk-skills1.local/schemas/g-kade/skill-contract.schema.json",
  "title": "g-kade Skill Contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "activates_when": {"type": "array", "items": {"type": "string"}, "default": []},
    "does_not_activate_when": {"type": "array", "items": {"type": "string"}, "default": []},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {"type": "array", "items": {"type": "string"}, "default": []},
        "optional": {"type": "array", "items": {"type": "string"}, "default": []}
      },
      "required": ["required", "optional"]
    },
    "reads": {"type": "array", "items": {"type": "string"}, "default": []},
    "writes": {"type": "array", "items": {"type": "string"}, "default": []},
    "side_effects": {"type": "array", "items": {"type": "string"}, "default": []},
    "confirmation_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reversible": {"type": "string", "minLength": 1},
        "consequential": {"type": "string", "minLength": 1}
      },
      "required": ["reversible", "consequential"]
    },
    "output_schema": {"type": ["string", "object"]},
    "verification": {"type": "array", "items": {"type": "string"}, "default": []},
    "failure_behavior": {"type": "array", "items": {"type": "string"}, "default": []}
  },
  "required": [
    "name",
    "version",
    "owner",
    "purpose",
    "activates_when",
    "does_not_activate_when",
    "inputs",
    "reads",
    "writes",
    "side_effects",
    "confirmation_policy",
    "output_schema",
    "verification",
    "failure_behavior"
  ]
}
