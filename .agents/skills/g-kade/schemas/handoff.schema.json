{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pk-skills1.local/schemas/g-kade/handoff.schema.json",
  "title": "g-kade Agent Handoff",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "definition_of_done": {"type": "string", "minLength": 1},
    "exclusive_scope": {"type": "string", "minLength": 1},
    "files_or_systems_owned": {"type": "array", "items": {"type": "string"}, "default": []},
    "inputs": {"type": "array", "items": {"type": "string"}, "default": []},
    "constraints": {"type": "array", "items": {"type": "string"}, "default": []},
    "non_goals": {"type": "array", "items": {"type": "string"}, "default": []},
    "required_evidence": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation": {"type": "array", "items": {"type": "string"}, "default": []},
    "allowed_side_effects": {"type": "array", "items": {"type": "string"}, "default": []},
    "blocked_actions": {"type": "array", "items": {"type": "string"}, "default": []},
    "strategy_family": {"type": "string", "minLength": 1},
    "collision_policy": {"type": "string", "minLength": 1},
    "reconciliation_owner": {"type": "string", "minLength": 1},
    "return_format": {"type": "string", "minLength": 1}
  },
  "required": [
    "contract_id",
    "agent_id",
    "objective",
    "definition_of_done",
    "exclusive_scope",
    "files_or_systems_owned",
    "constraints",
    "non_goals",
    "required_evidence",
    "validation",
    "allowed_side_effects",
    "blocked_actions",
    "strategy_family",
    "collision_policy",
    "reconciliation_owner",
    "return_format"
  ]
}
