# Add this table to ~/.codex/config.toml to register the pk-speak MCP server.
# Replace <abs path> with the absolute path to your pi-speak-extension repo root.
# Example: /home/you/pi-speak-extension  or  C:\dev\Desktop-Projects\pi-speak-extension

[mcp_servers.pk-speak]
command = "node"
args = ["<abs path>/dist/pk-speak-mcp.js"]
