# pk-speak environment template.
# Copy to .env and fill in real values; .env is gitignored. Never commit secrets.
#
# Real-time transport
# --------------------
# Gemini Live is the default real-time backend and the recommended transport.
# It is selected automatically when NO S2S-related variable below is set, and
# explicitly with PI_SPEAK_LIVE_BACKEND=gemini (always wins).
#
# WARNING: setting any of these silently switches the real-time path to the
# OpenAI-Realtime / HF speech-to-speech adapter instead of Gemini Live:
#   PI_SPEAK_HF_REALTIME_URL, HF_REALTIME_URL, SPEECH_TO_SPEECH_URL,
#   PI_SPEAK_S2S_URL, PI_SPEAK_OPENAI_REALTIME_URL,
#   PI_SPEAK_LIVE_BACKEND=hf|openai-realtime|s2s
PI_SPEAK_LIVE_BACKEND=gemini

# Gemini Developer API key (direct Google key, simplest).
# Used when PI_SPEAK_GEMINI_BACKEND is unset or "developer-api".
GOOGLE_API_KEY=

# Alt: Vertex AI backend (if your Google Cloud trial key is Vertex-bound).
# Enable the Vertex AI API on the project, then either run
# `gcloud auth application-default login` on the host or set PI_SPEAK_VERTEX_API_KEY.
# PI_SPEAK_GEMINI_BACKEND=vertex
# PI_SPEAK_VERTEX_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

# Gemini real-time + TTS models (defaults are sound; override if needed)
# PI_SPEAK_GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# PI_SPEAK_GEMINI_TEXT_MODEL=gemini-3.5-flash

# Speech out
# ----------
# TTS provider, independent of the live transport. gemini or edge work with no
# extra key; elevenlabs needs ELEVENLABS_API_KEY in the environment.
# auto|legacy|edge|gemini|openai|elevenlabs|sag|higgs|stable-audio
PI_SPEAK_TTS_PROVIDER=gemini
# PI_SPEAK_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# PI_SPEAK_GEMINI_TTS_VOICE=Kore

# Server
# ------
# PI_SPEAK_HTTP_PORT=3080